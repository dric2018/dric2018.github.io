<div class="badge-container" aria-label="Research Interests">
  {% for item in site.data.research_interests %}
    {% if item.url %}
      <strong><a href="{{ item.url }}" class="research-badge {{ item.class }}">{{ item.label }}</a></strong>
    {% else %}
      <span class="research-badge {{ item.class }}">{{ item.label }}</span>
    {% endif %}
    {% unless forloop.last %}
      <span class="badge-separator" aria-hidden="true">|</span>
    {% endunless %}
  {% endfor %}
</div>